# Copy this file to .env at the repository root or pass it with:
# docker compose --env-file docker/.env.example up
#
# Placeholder values only. Do not store real secrets in this file.

ENVIRONMENT=dev
DRY_RUN=true
AWS_REGION=us-east-1

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-local-only

N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=change-me-local-dev-encryption-key
N8N_USER_MANAGEMENT_DISABLED=true
GENERIC_TIMEZONE=America/New_York

PYTHON_AGENT_RUNNER_PORT=8000

# Default local dry-run search provider. Other no-key options:
# SEARCH_PROVIDER=searxng
# SEARCH_PROVIDER=rss
SEARCH_PROVIDER=placeholder
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_PUBLIC_BASE_URL=http://localhost:8080/
SEARXNG_PORT=8080
RSS_FEED_URLS=https://example.com/feed.xml,https://example.org/rss.xml
STORAGE_PROVIDER=memory

OLLAMA_PORT=11434
