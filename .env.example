# Agentic Newsroom local configuration example
# Copy to .env for local use. Do not commit real .env files.

ENVIRONMENT=dev
DRY_RUN=true
AWS_REGION=us-east-1

# External providers are intentionally disabled in the initial scaffold.
# Supported local-first search providers:
# SEARCH_PROVIDER=placeholder
# SEARCH_PROVIDER=searxng
# SEARCH_PROVIDER=rss
SEARCH_PROVIDER=placeholder
SEARXNG_BASE_URL=http://searxng:8080
RSS_FEED_URLS=https://example.com/feed.xml,https://example.org/rss.xml
RSS_SOURCE_REGISTRY_PATH=config/sources/rss_sources.yml
RSS_SOURCE_IDS=zdi_published_2026
RSS_DEFAULT_MAX_ITEMS=25
RSS_DEFAULT_EXCERPT_CHARS=800
RSS_CACHE_TTL_SECONDS=900
NEWSROOM_DEFAULT_MAX_SOURCES=25
NEWSROOM_SYSTEM_MAX_SOURCES=250
STORAGE_PROVIDER=memory

# Optional local auth scaffold. Leave disabled for local dev.
REQUIRE_AUTH=false
NEWSROOM_API_KEY=replace-with-local-dev-placeholder
