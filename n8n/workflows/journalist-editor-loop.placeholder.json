    },
    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\nconst headers = $json.headers ?? {};\nconst topic = typeof input.topic === 'string' ? input.topic.trim() : '';\nconst optionalFields = [\n  'audience',\n  'angle',\n  'source_provider',\n  'source_ids',\n  'max_sources',\n  'tags',\n  'category',\n  'sort',\n  'output_format',\n  'page_size',\n  'cursor'\n];\nconst request = { topic };\nfor (const field of optionalFields) {\n  if (Object.prototype.hasOwnProperty.call(input, field) && input[field] !== undefined) {\n    request[field] = input[field];\n  }\n}\nconst clientApiKey = headers['x-newsroom-api-key'] ?? headers['X-Newsroom-Api-Key'] ?? null;\nreturn [{\n  json: {\n    valid: topic.length >= 3,\n    validation_error: topic.length >= 3 ? null : 'A topic of at least 3 characters is required.',\n    research_request: request,\n    client_api_key: clientApiKey\n  }\n}];"
      },
      "id": "ae96a330-d132-482b-9e20-c88514d53995",
      "name": "Normalize Research Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        0
      ],
      "notes": "Preserves optional fields and leaves max_sources omitted when the caller omits it."
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
